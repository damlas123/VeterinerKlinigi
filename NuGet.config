<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet.config
  Bu projenin NuGet paketlerini nereden indireceğini belirtir.
  Depoda durduğu için proje hangi bilgisayarda açılırsa açılsın (hocanın bilgisayarı dahil)
  paketler nuget.org'dan indirilir; kullanıcının kendi NuGet ayarlarına bağımlı kalmaz.
-->
<configuration>
  <packageSources>
    <!-- Bilgisayardaki diğer kaynakları (ör. "Microsoft Visual Studio Offline Packages") bu proje için yok say -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <!-- Kullanıcı ayarlarında nuget.org devre dışı bırakılmış olsa bile bu projede etkin olsun -->
    <clear />
  </disabledPackageSources>
</configuration>
