<!--
  Directory.Packages.props  (Central Package Management)
  Projede kullanılan TÜM NuGet paketlerinin sürümleri burada, tek yerde tutulur.
  .csproj dosyalarında sadece paket adı yazılır, sürüm yazılmaz.

  ÖNEMLİ: .NET 11 (Kasım 2026) yayımlandı; NuGet yöneticisi 11.x sürümlerini
  "güncelleme" olarak önerebilir. Bu proje .NET 10 hedeflediği için
  Microsoft paketlerini 10.0.x sürümünde tutun, 11.x'e YÜKSELTMEYİN.
-->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Identity ve Entity Framework Core (Aşama 2'de projelere eklendi) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.15" />
  </ItemGroup>

  <!-- REST API: JWT (API projesi) ve OpenAPI dokümanı (Web projesi) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
  </ItemGroup>

  <!-- MCP sunucusu: resmî C# SDK (Web projesi) -->
  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>
</Project>
