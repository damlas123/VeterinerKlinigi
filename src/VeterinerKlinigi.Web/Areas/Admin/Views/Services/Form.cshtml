@model ServiceSaveDto
@{
    var id = ViewData["Id"] as int?;
    var clinics = (List<SelectListItem>)ViewData["Clinics"]!;
}

<a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Hizmetler</a>
<h1 class="h3 mt-1 mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-xl-8">
        <div class="card pv-card">
            <div class="card-body">
                <form asp-action="@(id is null ? "Create" : "Edit")" asp-route-id="@id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ClinicId" class="form-label"></label>
                            <select asp-for="ClinicId" asp-items="clinics" class="form-select">
                                <option value="">Klinik seçin</option>
                            </select>
                            <span asp-validation-for="ClinicId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: Genel Muayene" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Duration" class="form-label"></label>
                            <input asp-for="Duration" class="form-control" min="5" max="480" step="5" />
                            <span asp-validation-for="Duration" class="text-danger small"></span>
                            <div class="form-text">Çakışma kontrolünde randevunun bitiş saati bu süreyle hesaplanır.</div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Price" class="form-control" inputmode="decimal" />
                                <span class="input-group-text">₺</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" role="switch" />
                                <label asp-for="IsActive" class="form-check-label"></label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
