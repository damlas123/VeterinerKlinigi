@*
    Hekimin verebileceği hizmetler (Create ve Edit formlarında ortak).
    Yalnızca seçilen kliniğin hizmetleri gösterilir; klinik değişince diğer klinik
    hizmetlerinin işaretleri kaldırılır (sunucu tarafı da hizmetin klinikle eşleştiğini kontrol eder).
*@
@{
    var services = (List<ServiceDto>)ViewData["Services"]!;
    var selected = (HashSet<int>)ViewData["SelectedServiceIds"]!;
}
<label class="form-label">Verebildiği hizmetler</label>
<div class="pv-service-picker border rounded-3 p-3">
    <p class="small text-body-secondary mb-2" data-service-hint>Önce klinik seçin.</p>
    <div class="row g-2">
        @foreach (var s in services)
        {
            <div class="col-md-6" data-clinic-id="@s.ClinicId">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="ServiceIds" value="@s.Id" id="service-@s.Id" checked="@selected.Contains(s.Id)" />
                    <label class="form-check-label" for="service-@s.Id">
                        @s.Name <span class="text-body-secondary small">(@s.Duration dk · @s.Price.ToString("C0"))</span>
                        @if (!s.IsActive) { <span class="badge text-bg-secondary">pasif</span> }
                    </label>
                </div>
            </div>
        }
    </div>
</div>
