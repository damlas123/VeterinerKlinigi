@model VeterinarianCreateDto
@{
    ViewData["Title"] = "Yeni veteriner";
    var clinics = (List<SelectListItem>)ViewData["Clinics"]!;
}

<a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Veterinerler</a>
<h1 class="h3 mt-1 mb-4">Yeni veteriner</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <div class="row g-4">
        <div class="col-xl-6">
            <div class="card pv-card h-100">
                <div class="card-body">
                    <h2 class="h6 mb-3"><i class="bi bi-person-lock me-1"></i>Giriş hesabı</h2>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                            <div class="form-text">En az 8 karakter; büyük harf, küçük harf ve rakam içermeli.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card pv-card h-100">
                <div class="card-body">
                    <h2 class="h6 mb-3"><i class="bi bi-person-badge me-1"></i>Hekim bilgileri</h2>
                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Örn: Vet. Hek. Ayşe Yılmaz" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Specialty" class="form-label"></label>
                            <input asp-for="Specialty" class="form-control" placeholder="Örn: Dahiliye" />
                            <span asp-validation-for="Specialty" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ClinicId" class="form-label"></label>
                            <select asp-for="ClinicId" asp-items="clinics" class="form-select">
                                <option value="">Klinik seçin</option>
                            </select>
                            <span asp-validation-for="ClinicId" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Biography" class="form-label"></label>
                            <textarea asp-for="Biography" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Biography" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card pv-card">
                <div class="card-body">
                    <partial name="_ServiceCheckboxes" />
                </div>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Vazgeç</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ServicePickerScript" />
}
