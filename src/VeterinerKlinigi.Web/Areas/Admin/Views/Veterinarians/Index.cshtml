@model List<VeterinarianDto>
@{
    ViewData["Title"] = "Veterinerler";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Veterinerler</h1>
        <p class="text-body-secondary mb-0">Hekim kaydı oluşturulurken "Veteriner" rolünde bir giriş hesabı da açılır.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-person-plus me-1"></i>Yeni veteriner</a>
</div>

<div class="card pv-card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="pv-empty"><i class="bi bi-person-badge"></i><p class="mb-0">Henüz veteriner yok.</p></div>
        }
        else
        {
            <div class="pv-table-tools mb-3">
            <div class="pv-search">
                <i class="bi bi-search"></i>
                <input type="search" class="form-control" placeholder="Veteriner ara (ad, uzmanlık, klinik)" aria-label="Veteriner ara (ad, uzmanlık, klinik)" data-table-search="#vetTable" />
            </div>
        </div>
        <div class="table-responsive">
                <table class="table pv-table align-middle mb-0" id="vetTable">
                    <thead><tr><th>Hekim</th><th>Klinik</th><th>Uzmanlık</th><th>Hizmetler</th><th>Durum</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr class="@(v.IsActive ? "" : "opacity-50")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="pv-avatar">@DisplayText.Initial(v.FullName)</span>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@v.Id" class="fw-semibold text-decoration-none">@v.FullName</a>
                                            <div class="small text-body-secondary">@v.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@v.ClinicName</td>
                                <td>@v.Specialty</td>
                                <td class="small">@string.Join(", ", v.Services.Select(s => s.Name))</td>
                                <td>@if (v.IsActive) { <span class="badge pv-status-approved">Aktif</span> } else { <span class="badge text-bg-secondary">Pasif</span> }</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-sm btn-light rounded-pill" title="Detay"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-sm btn-outline-primary rounded-pill" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@v.Id" class="btn btn-sm btn-outline-danger rounded-pill" title="Sil"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
