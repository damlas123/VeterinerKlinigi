@model List<ClinicDto>
@{
    ViewData["Title"] = "Klinikler";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Klinikler</h1>
        <p class="text-body-secondary mb-0">Kliniklerin iletişim bilgileri ve çalışma saatleri</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1"></i>Yeni klinik</a>
</div>

<div class="card pv-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table pv-table align-middle mb-0">
                <thead>
                    <tr><th>Klinik</th><th>İletişim</th><th>Çalışma saatleri</th><th class="text-center">Veteriner</th><th class="text-center">Hizmet</th><th>Durum</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr class="@(c.IsActive ? "" : "opacity-50")">
                            <td><div class="fw-semibold">@c.Name</div><div class="small text-body-secondary">@c.Address</div></td>
                            <td class="small">@c.Phone<br />@c.Email</td>
                            <td>@c.OpeningTime.ToString("HH:mm") - @c.ClosingTime.ToString("HH:mm")</td>
                            <td class="text-center">@c.VeterinarianCount</td>
                            <td class="text-center">@c.ServiceCount</td>
                            <td>@if (c.IsActive) { <span class="badge pv-status-approved">Aktif</span> } else { <span class="badge text-bg-secondary">Pasif</span> }</td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Services" asp-action="Index" asp-route-clinicId="@c.Id" class="btn btn-sm btn-light rounded-pill" title="Hizmetler"><i class="bi bi-clipboard2-pulse"></i></a>
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary rounded-pill" title="Düzenle"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger rounded-pill" title="Sil"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
