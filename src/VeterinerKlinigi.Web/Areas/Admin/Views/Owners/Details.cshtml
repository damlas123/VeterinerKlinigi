@model UserDetailDto
@{
    var u = Model.User;
    ViewData["Title"] = u.FullName;
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Kullanıcılar</a>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-2 mb-4">
    <div class="d-flex align-items-center gap-3">
        <span class="pv-avatar pv-avatar-lg">@DisplayText.Initial(u.FullName)</span>
        <div>
            <h1 class="h3 mb-1">@u.FullName</h1>
            <div class="text-body-secondary">@u.Email · @(u.PhoneNumber ?? "telefon yok")</div>
            <div class="mt-1">@foreach (var r in u.Roles) { <span class="badge pv-badge me-1">@r</span> }</div>
        </div>
    </div>
    @if (!u.Roles.Contains(RoleNames.Admin))
    {
        @if (u.IsLockedOut)
        {
            <form asp-action="Unlock" asp-route-id="@u.Id" method="post">
                <button type="submit" class="btn btn-outline-primary rounded-pill"><i class="bi bi-unlock me-1"></i>Hesabın kilidini aç</button>
            </form>
        }
        else
        {
            <form asp-action="Lock" asp-route-id="@u.Id" method="post" data-confirm="@u.FullName hesabı kilitlensin mi? Kullanıcı giriş yapamaz.">
                <button type="submit" class="btn btn-outline-danger rounded-pill"><i class="bi bi-lock me-1"></i>Hesabı kilitle</button>
            </form>
        }
    }
</div>

<div class="row g-4">
    <div class="col-xl-5">
        <div class="card pv-card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">Evcil hayvanları (@Model.Pets.Count)</h2>
                @if (Model.Pets.Count == 0)
                {
                    <p class="text-body-secondary small mb-0">Kayıtlı evcil hayvan yok.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var p in Model.Pets)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <a asp-controller="Pets" asp-action="Details" asp-route-id="@p.Id" class="fw-semibold text-decoration-none">@p.Name</a>
                                    <div class="small text-body-secondary">@p.SpeciesName · @(p.Breed ?? "-") · @DisplayText.Age(p.BirthDate, today)</div>
                                </div>
                                @if (!p.IsActive) { <span class="badge text-bg-secondary">Arşiv</span> }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-7">
        <div class="card pv-card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">Son randevuları</h2>
                @{ ViewData["ShowOwner"] = false; ViewData["ShowVet"] = true; }
                <partial name="_AppointmentTable" model="Model.RecentAppointments" view-data="ViewData" />
            </div>
        </div>
    </div>
</div>
