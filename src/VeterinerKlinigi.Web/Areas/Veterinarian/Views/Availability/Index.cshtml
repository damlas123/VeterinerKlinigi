@model List<AvailabilityDto>
@{
    ViewData["Title"] = "Müsaitlik saatlerim";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Müsaitlik saatlerim</h1>
        <p class="text-body-secondary mb-0">Üyeler yalnızca bu aralıklarda ve kliniğin çalışma saatleri içinde randevu alabilir.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-plus-lg me-1"></i>Aralık ekle</a>
</div>

<div class="card pv-card">
    <div class="card-body">
        @{ ViewData["CanManage"] = true; }
        <partial name="_AvailabilityTable" model="Model" view-data="ViewData" />
    </div>
</div>
