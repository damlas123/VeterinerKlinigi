@model ExaminationNoteSaveDto
@{
    var note = (ExaminationNoteDto)ViewData["Note"]!;
    ViewData["Title"] = "Muayene notunu düzenle";
}

<a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Muayene notlarım</a>
<h1 class="h3 mt-1 mb-1">Muayene notunu düzenle</h1>
<p class="text-body-secondary mb-4"><strong>@note.PetName</strong> · @note.ServiceName · @note.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</p>

<div class="row">
    <div class="col-xl-8">
        <div class="card pv-card">
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@note.Id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Diagnosis" class="form-label"></label>
                        <input asp-for="Diagnosis" class="form-control" />
                        <span asp-validation-for="Diagnosis" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Treatment" class="form-label"></label>
                        <textarea asp-for="Treatment" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Treatment" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
