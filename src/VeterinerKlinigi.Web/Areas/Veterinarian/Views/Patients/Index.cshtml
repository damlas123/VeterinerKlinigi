@model List<PetDto>
@{
    ViewData["Title"] = "Hastalarım";
    var search = ViewData["Search"] as string;
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Hastalarım</h1>
        <p class="text-body-secondary mb-0">Size en az bir randevu almış evcil hayvanlar</p>
    </div>
    <form method="get" class="d-flex gap-2">
        <input type="search" name="search" value="@search" class="form-control" placeholder="Hayvan, ırk veya sahip" />
        <button class="btn btn-outline-primary rounded-pill" type="submit"><i class="bi bi-search"></i></button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="card pv-card"><div class="card-body"><div class="pv-empty"><i class="bi bi-heart"></i><p class="mb-0">Hasta bulunamadı.</p></div></div></div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            <div class="col-sm-6 col-xl-4">
                <div class="card pv-card h-100">
                    <div class="card-body d-flex gap-3 align-items-center">
                        @if (p.PhotoUrl is not null) { <img src="@p.PhotoUrl" alt="" class="pv-pet-photo" /> } else { <div class="pv-pet-photo pv-pet-placeholder"><i class="bi bi-heart"></i></div> }
                        <div class="flex-grow-1">
                            <a asp-action="Details" asp-route-id="@p.Id" class="stretched-link fw-semibold text-decoration-none fs-5">@p.Name</a>
                            <div class="small text-body-secondary">@p.SpeciesName · @(p.Breed ?? "-")</div>
                            <div class="small">@DisplayText.Age(p.BirthDate, today) · @p.Weight.ToString("0.##") kg</div>
                            <div class="small text-body-secondary"><i class="bi bi-person me-1"></i>@p.OwnerName</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
