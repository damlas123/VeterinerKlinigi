@model List<AppointmentDto>
@{
    ViewData["Title"] = "Randevularım";
    var filter = (AppointmentFilter)ViewData["Filter"]!;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Randevularım</h1>
        <p class="text-body-secondary mb-0">Evcil hayvanlarınız için alınan randevular · @Model.Count kayıt</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill"><i class="bi bi-calendar-plus me-1"></i>Yeni randevu</a>
</div>

<partial name="_AppointmentFilter" model="filter" />

<div class="card pv-card">
    <div class="card-body">
        @{ ViewData["ShowOwner"] = false; ViewData["ShowVet"] = true; }
        <partial name="_AppointmentTable" model="Model" view-data="ViewData" />
    </div>
</div>
