@model PetFormViewModel
@{
    var species = Enum.GetValues<PetSpecies>().Select(s => new SelectListItem(DisplayText.Species(s), s.ToString()));
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<a asp-action="@(Model.Id is null ? "Index" : "Details")" asp-route-id="@Model.Id" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Geri dön</a>
<h1 class="h3 mt-1 mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-xl-8">
        <div class="card pv-card">
            <div class="card-body">
                <form asp-action="@(Model.Id is null ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" placeholder="Örn: Pamuk" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Species" class="form-label"></label>
                            <select asp-for="Species" asp-items="species" class="form-select"></select>
                            <span asp-validation-for="Species" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Breed" class="form-label"></label>
                            <input asp-for="Breed" class="form-control" placeholder="Örn: British Shorthair" />
                            <span asp-validation-for="Breed" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="BirthDate" class="form-label"></label>
                            <input asp-for="BirthDate" type="date" class="form-control" max="@today" />
                            <span asp-validation-for="BirthDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Weight" class="form-label"></label>
                            <input asp-for="Weight" type="text" inputmode="decimal" class="form-control" placeholder="4,5" />
                            <span asp-validation-for="Weight" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Photo" class="form-label"></label>
                            <div class="d-flex align-items-center gap-3">
                                <img id="photoPreview" src="@Model.CurrentPhotoUrl" alt="" class="pv-pet-photo @(Model.CurrentPhotoUrl is null ? "d-none" : "")" />
                                <div class="flex-grow-1">
                                    <input asp-for="Photo" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                                    <div class="form-text">JPG, PNG veya WEBP · en fazla 2 MB.</div>
                                    <span asp-validation-for="Photo" class="text-danger small"></span>
                                </div>
                            </div>
                            @if (Model.CurrentPhotoUrl is not null)
                            {
                                <input type="hidden" asp-for="CurrentPhotoUrl" />
                                <div class="form-check mt-2">
                                    <input asp-for="RemovePhoto" class="form-check-input" />
                                    <label asp-for="RemovePhoto" class="form-check-label"></label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                        <a asp-action="@(Model.Id is null ? "Index" : "Details")" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Seçilen fotoğrafın önizlemesi (dosya sunucuya gönderilmeden tarayıcıda gösterilir).
        $('#Photo').on('change', function () {
            var file = this.files && this.files[0];
            if (!file) { return; }
            if (file.size > 2 * 1024 * 1024) {
                alertBox('Fotoğraf en fazla 2 MB olabilir.');
                this.value = '';
                return;
            }
            $('#photoPreview').attr('src', URL.createObjectURL(file)).removeClass('d-none');
            $('#RemovePhoto').prop('checked', false);
        });

        function alertBox(message) {
            $('[data-valmsg-for="Photo"]').text(message);
        }
    </script>
}
