@model ProfileViewModel
@{
    ViewData["Title"] = "Profilim";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <partial name="_StatusMessage" />
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">Profilim</h1>
                <a asp-controller="Panel" asp-action="Index" class="btn btn-outline-primary rounded-pill"><i class="bi bi-speedometer2 me-1"></i>Panelime dön</a>
            </div>
            <div class="card pv-card">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <span class="pv-avatar pv-avatar-lg">@DisplayText.Initial(Model.FirstName)</span>
                        <div>
                            <div class="fw-semibold">@Model.Email</div>
                            <div class="small text-body-secondary">
                                Rol: @string.Join(", ", Model.Roles.Select(r => r == RoleNames.Admin ? "Yönetici" : r == RoleNames.Veterinarian ? "Veteriner" : "Üye"))
                                · Üyelik: @Model.CreatedAt.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                    </div>

                    <form asp-action="Profile" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <label asp-for="FirstName" class="form-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="LastName" class="form-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label">E-posta</label>
                                <input value="@Model.Email" class="form-control" disabled />
                                <div class="form-text">E-posta giriş adınızdır, değiştirilemez.</div>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="PhoneNumber" class="form-label"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                            <a asp-action="ChangePassword" class="btn btn-outline-primary rounded-pill px-4"><i class="bi bi-key me-1"></i>Parola değiştir</a>
                            <a asp-action="ApiToken" class="btn btn-outline-primary rounded-pill px-4"><i class="bi bi-robot me-1"></i>API / MCP anahtarı</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
