@{
    ViewData["Title"] = "Erişim reddedildi";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card pv-card text-center">
                <div class="card-body p-5">
                    <div class="pv-icon pv-icon-peach mx-auto mb-3"><i class="bi bi-shield-x"></i></div>
                    <h1 class="h3 mb-3">Erişim reddedildi</h1>
                    <p class="text-body-secondary mb-4">Bu sayfayı görüntüleme yetkiniz yok. Farklı bir hesapla giriş yapmanız gerekebilir.</p>
                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Panel" asp-action="Index" class="btn btn-primary rounded-pill px-4">Panelime git</a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light rounded-pill px-4">Ana sayfa</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
