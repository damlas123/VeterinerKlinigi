@model AvailabilitySaveDto
@* Müsaitlik formu — Admin ve Veteriner panelinde ortak. Form, bulunulan panelin Availability controller'ına gönderilir. *@
@{
    var id = ViewData["Id"] as int?;
    var days = (List<SelectListItem>)ViewData["Days"]!;
}

<a href="@ViewData["CancelUrl"]" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Geri dön</a>
<h1 class="h3 mt-1 mb-4">@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-7">
        <div class="card pv-card">
            <div class="card-body">
                <form asp-action="@(id is null ? "Create" : "Edit")" asp-route-id="@id" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="VeterinarianId" />

                    <div class="mb-3">
                        <label asp-for="DayOfWeek" class="form-label"></label>
                        <select asp-for="DayOfWeek" asp-items="days" class="form-select"></select>
                        <span asp-validation-for="DayOfWeek" class="text-danger small"></span>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label asp-for="StartTime" class="form-label"></label>
                            <input asp-for="StartTime" class="form-control" step="900" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="EndTime" class="form-label"></label>
                            <input asp-for="EndTime" class="form-control" step="900" />
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="form-text mb-3">
                        Aralık kliniğin çalışma saatleri içinde olmalı ve aynı gündeki diğer aralıklarla çakışmamalıdır.
                        Öğle arası için aynı güne iki ayrı aralık ekleyebilirsiniz (ör. 09:00-12:30 ve 13:30-18:00).
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary rounded-pill px-4"><i class="bi bi-check-lg me-1"></i>Kaydet</button>
                        <a href="@ViewData["CancelUrl"]" class="btn btn-light rounded-pill px-4">Vazgeç</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
