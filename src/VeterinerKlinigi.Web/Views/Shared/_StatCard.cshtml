@model StatCardModel
<div class="card pv-card pv-stat h-100">
    <div class="card-body d-flex align-items-center gap-3">
        <div class="pv-icon @Model.Color"><i class="bi @Model.Icon"></i></div>
        <div class="flex-grow-1">
            <div class="text-body-secondary small">@Model.Title</div>
            <div class="fs-4 fw-bold lh-sm">@Model.Value</div>
            @if (Model.Hint is not null)
            {
                <div class="small text-body-secondary">@Model.Hint</div>
            }
        </div>
        @if (Model.Url is not null)
        {
            <a href="@Model.Url" class="stretched-link" aria-label="@Model.Title"></a>
        }
    </div>
</div>
