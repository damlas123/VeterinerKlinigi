@using System.Security.Claims
@* Sağ üst köşe: giriş yapılmamışsa Giriş/Kayıt, yapılmışsa kullanıcı menüsü. *@
@if (User.Identity?.IsAuthenticated == true)
{
    var fullName = User.FindFirst(AppClaimTypes.FullName)?.Value ?? User.Identity.Name;
    var roleText = User.IsInRole(RoleNames.Admin) ? "Yönetici" : User.IsInRole(RoleNames.Veterinarian) ? "Veteriner Hekim" : "Üye";
    <ul class="navbar-nav align-items-lg-center gap-2">
        <li class="nav-item">
            <a class="btn btn-primary rounded-pill px-3" asp-area="" asp-controller="Panel" asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i>Panelim
            </a>
        </li>
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="pv-avatar">@DisplayText.Initial(fullName)</span>
                <span class="d-flex flex-column lh-sm">
                    <span class="fw-semibold">@fullName</span>
                    <small class="text-body-secondary">@roleText</small>
                </span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Profilim</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Parola değiştir</a></li>
                <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="ApiToken"><i class="bi bi-robot me-2"></i>API / MCP anahtarı</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış yap</button>
                    </form>
                </li>
            </ul>
        </li>
    </ul>
}
else
{
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary rounded-pill px-3" asp-area="" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i>Giriş yap
        </a>
        <a class="btn btn-primary rounded-pill px-3" asp-area="" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i>Kayıt ol
        </a>
    </div>
}
