@model AppointmentDetailDto
@*
    Randevu detayı — üç panelde ortak görünüm (Admin, Veteriner, Üye).
    Hangi düğmelerin görüneceğine iş katmanı karar verir (CanApprove, CanCancel ...);
    düğmeler bulunulan panelin Appointments controller'ına gönderilir.
*@
@{
    var a = Model.Appointment;
    var area = ViewContext.RouteData.Values["area"] as string;
    ViewData["Title"] = $"Randevu #{a.Id}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="small text-decoration-none"><i class="bi bi-arrow-left"></i> Randevular</a>
        <h1 class="h3 mb-0 mt-1">Randevu #@a.Id</h1>
    </div>
    <partial name="_StatusBadge" model="a.Status" />
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card pv-card">
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-sm-6">
                        <div class="pv-label">Tarih ve saat</div>
                        <div class="fs-5 fw-semibold">@a.AppointmentDate.ToString("dd MMMM yyyy dddd")</div>
                        <div>@a.AppointmentDate.ToString("HH:mm") - @a.EndDate.ToString("HH:mm") <span class="text-body-secondary">(@a.Duration dk)</span></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="pv-label">Hizmet</div>
                        <div class="fs-5 fw-semibold">@a.ServiceName</div>
                        <div>@a.ClinicName · <strong>@a.Price.ToString("C2")</strong></div>
                    </div>
                    <div class="col-sm-6">
                        <div class="pv-label">Evcil hayvan</div>
                        <div class="fw-semibold">@a.PetName <span class="text-body-secondary fw-normal">(@DisplayText.Species(a.Species))</span></div>
                        @if (area == "Member")
                        {
                            <a asp-controller="Pets" asp-action="Details" asp-route-id="@a.PetId" class="small">Sağlık geçmişi</a>
                        }
                        else if (area == "Veterinarian")
                        {
                            <a asp-controller="Patients" asp-action="Details" asp-route-id="@a.PetId" class="small">Sağlık geçmişi</a>
                        }
                        else
                        {
                            <a asp-controller="Pets" asp-action="Details" asp-route-id="@a.PetId" class="small">Sağlık geçmişi</a>
                        }
                    </div>
                    <div class="col-sm-6">
                        <div class="pv-label">Veteriner</div>
                        <div class="fw-semibold">@a.VeterinarianName</div>
                    </div>
                    @if (area != "Member")
                    {
                        <div class="col-sm-6">
                            <div class="pv-label">Hayvan sahibi</div>
                            <div class="fw-semibold">@a.OwnerName</div>
                            <div class="small text-body-secondary">@Model.OwnerEmail @(Model.OwnerPhone is null ? "" : " · " + Model.OwnerPhone)</div>
                        </div>
                    }
                    <div class="col-sm-6">
                        <div class="pv-label">Oluşturulma</div>
                        <div>@a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(a.OwnerNote))
                    {
                        <div class="col-12">
                            <div class="pv-label">Sahibinin notu</div>
                            <div class="pv-note">@a.OwnerNote</div>
                        </div>
                    }
                    @if (a.Status == AppointmentStatus.Rejected && !string.IsNullOrWhiteSpace(a.RejectionReason))
                    {
                        <div class="col-12">
                            <div class="alert alert-danger mb-0"><strong>Ret gerekçesi:</strong> @a.RejectionReason</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (Model.ExaminationNote is { } note)
        {
            <div class="card pv-card mt-4">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0"><i class="bi bi-journal-medical me-2 text-primary"></i>Muayene notu</h2>
                    <small class="text-body-secondary">@note.VeterinarianName · @note.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <div class="card-body">
                    <div class="pv-label">Tanı</div>
                    <p>@note.Diagnosis</p>
                    <div class="pv-label">Tedavi</div>
                    <p>@note.Treatment</p>
                    @if (!string.IsNullOrWhiteSpace(note.Notes))
                    {
                        <div class="pv-label">Ek notlar</div>
                        <p class="mb-0">@note.Notes</p>
                    }
                    @if (area == "Veterinarian")
                    {
                        <a asp-controller="ExaminationNotes" asp-action="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary rounded-pill mt-2"><i class="bi bi-pencil me-1"></i>Notu düzenle</a>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card pv-card">
            <div class="card-body d-grid gap-2">
                <h2 class="h6 text-body-secondary mb-1">İşlemler</h2>

                @if (Model.CanApprove)
                {
                    <form asp-action="Approve" asp-route-id="@a.Id" method="post" class="d-grid">
                        <button type="submit" class="btn btn-primary rounded-pill"><i class="bi bi-check-circle me-1"></i>Onayla</button>
                    </form>
                }
                @if (Model.CanReject)
                {
                    <a asp-action="Reject" asp-route-id="@a.Id" class="btn btn-outline-danger rounded-pill"><i class="bi bi-x-circle me-1"></i>Reddet</a>
                }
                @if (Model.CanComplete)
                {
                    <a asp-action="Complete" asp-route-id="@a.Id" class="btn btn-primary rounded-pill"><i class="bi bi-clipboard2-check me-1"></i>Muayeneyi tamamla</a>
                }
                @if (Model.CanEdit && area == "Member")
                {
                    <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-outline-primary rounded-pill"><i class="bi bi-pencil me-1"></i>Tarih / saati değiştir</a>
                }
                @if (Model.CanCancel && area != "Veterinarian")
                {
                    <form asp-action="Cancel" asp-route-id="@a.Id" method="post" class="d-grid" data-confirm="Randevuyu iptal etmek istediğinize emin misiniz?">
                        <button type="submit" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-slash-circle me-1"></i>İptal et</button>
                    </form>
                }
                @if (Model.CanDelete && area == "Admin")
                {
                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-grid" data-confirm="Randevu kaydı kalıcı olarak silinecek. Emin misiniz?">
                        <button type="submit" class="btn btn-outline-danger rounded-pill"><i class="bi bi-trash me-1"></i>Kaydı sil</button>
                    </form>
                }
                @if (!Model.CanApprove && !Model.CanReject && !Model.CanComplete && !Model.CanEdit && !Model.CanCancel && !Model.CanDelete)
                {
                    <p class="text-body-secondary small mb-0">Bu randevu için yapılabilecek bir işlem yok.</p>
                }
            </div>
        </div>

        <div class="card pv-card mt-3">
            <div class="card-body small text-body-secondary">
                <i class="bi bi-info-circle me-1"></i>
                Randevular <strong>Bekliyor</strong> durumunda oluşur; Admin veya ilgili veteriner onaylar ya da reddeder.
                Onaylanan randevu, muayene notu girilince <strong>Tamamlandı</strong> olur.
            </div>
        </div>
    </div>
</div>
